{
  "manifest_version": 3,
  "name": "ReSmart VIP",
  "version": "0.1.0",
  "description": "Flags cheaper open-box and refurbished alternatives while you shop on Amazon, eBay, and Facebook Marketplace.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.ebay.com/*",
    "https://*.facebook.com/marketplace/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.ebay.com/*",
        "https://*.facebook.com/marketplace/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReSmart VIP"
  }
}
