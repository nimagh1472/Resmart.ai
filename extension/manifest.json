{
  "manifest_version": 3,
  "name": "ReSmart",
  "version": "0.1.0",
  "description": "Flags cheaper open-box and refurbished alternatives while you shop on Amazon, Target, and Best Buy.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.target.com/*",
    "https://*.bestbuy.com/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.target.com/*",
        "https://*.bestbuy.com/*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReSmart"
  }
}
