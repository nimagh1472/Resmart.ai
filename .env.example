# Anthropic (server-side only — never expose with NEXT_PUBLIC_)
# Optional for /api/vision: without it the route still identifies products, but
# only from the URL slug, filename, and text (see lib/product-inference.ts) —
# image contents are not read. Set it to enable the Claude vision path.
ANTHROPIC_API_KEY=

# Stripe — a no-code Customer Portal link enables /api/stripe/portal as-is
STRIPE_CUSTOMER_PORTAL_URL=

# Admin API — shared bearer for /api/admin and /api/seed. Without it, those
# routes accept only a Supabase access token belonging to a role='admin' user.
ADMIN_API_TOKEN=

# Must be exactly "true" to enable /api/seed. It deletes and recreates
# accounts, so leave this unset outside local development.
ALLOW_SEED=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
